  "internal_codes": {
    "contracts": {
      "format": "ADM-CTR-{AGENCY}-{TYPE}-{YYYY}-{SEQUENCE}",
      "agency_tokens": {
        "Casablanca": "CAS",
        "Rabat": "RAB",
        "Marrakech": "MAR"
      },
      "type_tokens": {
        "courte durée": "CD",
        "longue durée": "LD",
        "abonnement": "ABO",
        "entreprise": "ENT"
      },
      "example": "ADM-CTR-CAS-CD-2026-000001"
    },
    "insurances": {
      "format": "ADM-INS-{LEVEL}",
      "codes": {
        "Basic": "ADM-INS-BASIC",
        "CDW Standard": "ADM-INS-CDW-STD",
        "CDW Premium": "ADM-INS-CDW-PRM",
        "Theft Protection": "ADM-INS-THEFT",
        "Full Protection": "ADM-INS-FULL"
      }
    },
    "vehicles": {
      "format": "ADM-VEH-{CATEGORY}-{BRAND}-{MODEL}-{SEQUENCE}",
      "example": "ADM-VEH-D-HYU-TUC-0001"
    },
    "maintenance": {
      "format": "ADM-MNT-{TYPE}-{YYYY}-{SEQUENCE}",
      "type_tokens": {
        "preventive": "PREV",
        "corrective": "CORR",
        "inspection": "INSP",
        "pneumatiques": "PNEU",
        "carrosserie": "CARR",
        "nettoyage": "NET"
      },
      "example": "ADM-MNT-PREV-2026-000001"
    }
  },
  "data_consistency_rules": {
    "required_reference_fields": [
      "agency_code",
      "category_code",
      "customer_type_code",
      "contract_type_code",
      "insurance_code",
      "vehicle_code"
    ],
    "generation_constraints": [
      "Utiliser uniquement les agences définies dans master_config.",
      "Utiliser uniquement les catégories A à F définies dans master_config.",
      "Associer chaque véhicule à une catégorie existante.",
      "Respecter l'âge minimum le plus élevé entre la règle générale et la catégorie.",
      "Utiliser les codes internes selon les formats définis.",
      "Ne jamais inventer une assurance, une agence ou un type de contrat hors configuration.",
      "Exprimer tous les montants en MAD.",
      "Exprimer toutes les durées en jours, heures ou minutes selon le champ.",
      "Conserver les mêmes noms, codes et valeurs dans tous les documents générés."
    ]
  }
}