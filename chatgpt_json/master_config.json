      "rules": [
        "Tout conducteur additionnel doit être déclaré dans le contrat.",
        "Il doit présenter un permis valide et respecter les conditions d'âge.",
        "La conduite par une personne non déclarée annule les protections contractuelles."
      ]
    },
    "fuel": {
      "policy": "plein à plein",
      "rules": [
        "Le véhicule est remis avec un niveau de carburant enregistré sur l'état de départ.",
        "Le client doit restituer le véhicule avec le même niveau.",
        "Le carburant manquant est facturé avec des frais de service de 150 MAD."
      ]
    },
    "mileage": {
      "short_term_included_km_per_day": 250,
      "long_term_included_km_per_month": 3000,
      "extra_km_rate_mad": {
        "A": 1.5,
        "B": 1.8,
        "C": 2.2,
        "D": 2.8,
        "E": 4.0,
        "F": 2.5
      },
      "rules": [
        "Le kilométrage inclus dépend du type de contrat.",
        "Les kilomètres supplémentaires sont facturés selon la catégorie.",
        "Le compteur est relevé au départ et à la restitution."
      ]
    },
    "late_return": {
      "grace_period_minutes": 30,
      "rules": [
        "Au-delà de 30 minutes, une heure supplémentaire peut être facturée.",
        "Au-delà de 3 heures, une journée supplémentaire peut être facturée.",
        "Un retard sans notification peut entraîner des frais administratifs de 300 MAD."
      ]
    },
    "accident": {
      "notification_deadline_hours": 2,
      "required_actions": [
        "sécuriser les personnes et le véhicule",
        "contacter les autorités si nécessaire",
        "remplir un constat",
        "prendre des photos",
        "contacter AutoDrive Maroc",
        "transmettre les documents sous 24 heures"
      ],
      "rules": [
        "Aucune reconnaissance de responsabilité ne doit être signée sans constat.",
        "La franchise dépend de l'assurance souscrite.",
        "La non-déclaration dans les délais peut entraîner la perte des protections."
      ]
    },
    "theft": {
      "notification_deadline_hours": 1,
      "required_actions": [
        "déposer plainte auprès de la police",
        "contacter immédiatement AutoDrive Maroc",
        "remettre les clés et documents du véhicule",
        "transmettre le récépissé de plainte"
      ],
      "rules": [
        "La protection vol ne s'applique pas si les clés ont été laissées dans le véhicule.",
        "Le client reste responsable jusqu'à remise des justificatifs.",
        "La franchise dépend de l'assurance souscrite."
      ]
    },
    "return": {
      "rules": [
        "Le véhicule doit être restitué dans l'agence, à la date et à l'heure prévues.",
        "Une restitution dans une autre agence doit être autorisée à l'avance.",
        "Un état contradictoire est réalisé au retour.",
        "Le véhicule doit être rendu avec ses clés, documents, accessoires et niveau de carburant convenu.",
        "Un nettoyage spécial peut être facturé à partir de 300 MAD."
      ]
    }
  },
