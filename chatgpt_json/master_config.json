    "deposit": {
      "payment_method": "préautorisation sur carte bancaire",
      "amount_basis": "catégorie du véhicule et assurance sélectionnée",
      "release_delay_business_days": 7,
      "rules": [
        "La caution est bloquée avant la remise du véhicule.",
        "La caution peut être utilisée pour couvrir franchise, carburant manquant, retard, dommages ou frais impayés.",
        "Une carte au nom du conducteur principal est obligatoire sauf convention entreprise."
      ]
